# SMTP Email Configuration for Vercel Deployment
# In Vercel Project Settings > Environment Variables, add these:

# SMTP Server details (e.g. Gmail, Resend, SendGrid, Mailgun, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication credentials
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Sender appearance
SMTP_FROM="CAF Pension Centre <noreply@caf-pension.ca>"
